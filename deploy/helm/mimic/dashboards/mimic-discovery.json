          "editorMode": "code",
          "expr": "sum by (direction, result) (rate(mimic_discovery_exchanges_total{job=\"mimic-sidecar\", namespace=\"$namespace\", deployment=\"$deployment\"}[$__rate_interval]))",
          "legendFormat": "{{direction}} {{result}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Exchanges by result",
      "type": "timeseries"
    },
    {
      "collapsed": false,
