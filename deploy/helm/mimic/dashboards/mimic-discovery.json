{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "expr": "count(time() - process_start_time_seconds{job=\"mimic-sidecar\", namespace=\"$namespace\", deployment=\"$deployment\"} < 60) > 0",
        "iconColor": "blue",
        "name": "Process started",
        "step": "60s",
        "titleFormat": "Process started"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "expr": "sum by (to) (increase(mimic_mock_mode_switches_total{job=\"mimic-sidecar\", namespace=\"$namespace\", deployment=\"$deployment\"}[2m])) > 0",
        "iconColor": "blue",
        "name": "Mode switch",
        "step": "60s",
        "titleFormat": "Mode switch to {{to}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "expr": "max(mimic_mock_latency_factor{job=\"mimic-sidecar\", namespace=\"$namespace\", deployment=\"$deployment\"}) != max(mimic_mock_latency_factor{job=\"mimic-sidecar\", namespace=\"$namespace\", deployment=\"$deployment\"} offset 2m)",
        "iconColor": "blue",
        "name": "Latency factor changed",
        "step": "60s",
        "titleFormat": "Latency factor changed"
      }
    ]
  },
  "description": "What discovery learns in one deployment, what it cannot record, and how reports and egress snapshots travel.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "mimic"
      ],
      "targetBlank": false,
      "title": "Mimic",
      "tooltip": "",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Learning",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Endpoints in the template tree, against MIMIC_DISCOVERY_MAX_ENDPOINTS (per direction).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "limit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (direction) (mimic_discovery_endpoints{job=\"mimic-sidecar\", namespace=\"$namespace\", deployment=\"$deployment\"})",
          "legendFormat": "{{direction}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(mimic_limit{job=\"mimic-sidecar\", namespace=\"$namespace\", deployment=\"$deployment\", name=\"discovery_max_endpoints\"})",
          "legendFormat": "limit",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Endpoints by direction, limit",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Time since an endpoint was last added. A long time means the learning has converged.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "time() - max by (direction) (mimic_discovery_last_new_endpoint_timestamp_seconds{job=\"mimic-sidecar\", namespace=\"$namespace\", deployment=\"$deployment\"} > 0)",
          "legendFormat": "{{direction}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Time since the last new endpoint",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "HTTP exchanges seen by discovery, by direction and result.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
